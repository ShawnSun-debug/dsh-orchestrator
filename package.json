{
  "name": "dsh-orchestrator",
  "version": "0.8.0",
  "private": true,
  "description": "Main agent that plans and dispatches work through a single dispatch tool; long-running workers are supervised by reading session logs; an optional master layer adds AI memory, a state index and cross-session messages",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "秘书",
      "en": "Secretary"
    },
    "icon": "chat",
    "contributes": {
      "panels": [
        {
          "id": "secretary",
          "title": {
            "zh": "秘书",
            "en": "Secretary"
          },
          "placement": [
            "features",
            "session.tab"
          ]
        }
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*",
    "zod": "*"
  },
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test test/"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "dsh-bundle",
    "orchestrator",
    "subagent",
    "planning"
  ],
  "license": "MIT",
  "author": "SShiRkiT (https://github.com/SShiRkiT)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SShiRkiT/dsh-orchestrator.git"
  },
  "homepage": "https://github.com/SShiRkiT/dsh-orchestrator#readme",
  "bugs": {
    "url": "https://github.com/SShiRkiT/dsh-orchestrator/issues"
  }
}
